{
  "name": "asclepius-web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10.9.2 <11"
  },
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build --webpack",
    "start": "python3 scripts/serve-static.py",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "verify": "npm run typecheck && npm run build && npm run test:e2e:smoke",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.15.21",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "8.5.28",
    "nanoid": "3.3.18",
    "js-yaml": "4.3.2",
    "browserslist": "4.28.9",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "description": "Browser-only synthetic care journeys and referral handoffs for healthcare stakeholders. NOT FOR CLINICAL USE.",
  "homepage": "https://safetymp.github.io/Asclepius/"
}
